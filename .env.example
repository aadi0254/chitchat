# ==============================================================================
# ChitChat Production & Local Environment Configuration
# ==============================================================================

# URL of the persistent Socket.IO real-time backend server.
#
# IMPORTANT FOR VERCEL DEPLOYMENT:
# The Next.js frontend is deployed on Vercel (serverless hosting), which cannot run
# persistent WebSocket servers (server.js).
# The backend must run on a persistent Node.js environment (e.g., Render, Railway,
# Fly.io, DigitalOcean App Platform, AWS EC2, Heroku, or a VPS).
# Set this environment variable in your Vercel Project Settings -> Environment Variables.
#
# Example production URL:
# NEXT_PUBLIC_SOCKET_URL=https://chitchat-backend.onrender.com
#
# Example local development URL (when running standalone backend on port 3001):
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

NEXT_PUBLIC_SOCKET_URL=

# Port for the Node.js Socket.IO server (used by server.js)
PORT=3000

# CORS Origin for Socket.IO server (set to your Vercel frontend domain in production, e.g. https://your-app.vercel.app)
CORS_ORIGIN=*

# Standalone mode (set to "true" when running only the Socket.IO backend without Next.js)
STANDALONE=false
